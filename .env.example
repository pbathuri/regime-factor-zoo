# WRDS credentials — fill in and rename to .env (NEVER commit .env)
# Get these from https://wrds-www.wharton.upenn.edu/ → My Account
WRDS_USERNAME=your_wrds_username_here
WRDS_PASSWORD=your_wrds_password_here

# Optional: pgpass-style auth (preferred for non-interactive runs)
# If you have ~/.pgpass set up, leave the password blank above
